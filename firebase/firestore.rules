rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /noteslist/{listId} {
        allow read, write: if request.auth != null;

        match /notes/{noteId} {
          allow read, write: if request.auth != null;
        }
      }

      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // El dueno manda por ruta: sin condiciones sobre `resource` para que la lectura
      // de la coleccion completa no dependa de que cada documento tenga `contributors`,
      // y para que `create` (donde `resource` es null) funcione.
      match /reminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Un invitado puede leer y editar el documento compartido, pero no borrarlo.
        allow read, update: if request.auth != null
          && resource != null
          && request.auth.uid in resource.data.get('contributors', []);
      }
    }

    // Comodin recursivo en la raiz: unico sitio donde una regla aplica a
    // `collectionGroup("reminders").whereArrayContains("contributors", uid)`.
    match /{path=**}/reminders/{reminderId} {
      allow read: if request.auth != null
        && resource != null
        && request.auth.uid in resource.data.get('contributors', []);
    }

    match /{document=**}/noteslist/{listId} {
      allow read, write: if request.auth != null;
    }

    match /users {
      allow read: if request.auth != null;
    }

    match /friendships/{friendshipId} {
      allow read, write: if request.auth != null;
    }

    match /usercodes/{dateKey} {
      allow read, write: if request.auth != null;
    }
  }
}
